# Server-side only. Never expose this value in browser code or commit a real key.
GEMINI_API_KEY=

# The provider boundary defaults to Gemma; live transport is not implemented in the first PR.
MODEL_PROVIDER=gemma
GEMMA_MODEL=gemma-4-26b-a4b-it

# Prototype safety limits; finalize values during implementation.
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1
