# Server-side only. Never expose this value in browser code or commit a real key.
GEMINI_API_KEY=

# The provider boundary defaults to hosted Gemma 4. Keep the key server-side.
MODEL_PROVIDER=gemma
GEMMA_MODEL=gemma-4-26b-a4b-it

# Enforced prototype safety limits.
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1

# Single-process demo only. Multiple workers/replicas are unsupported.
SOURCE_LIBRARY_ROOT=/tmp/proofline-source-library
SOURCE_LIBRARY_IDLE_MINUTES=30
SOURCE_LIBRARY_ABSOLUTE_MINUTES=120
SOURCE_LIBRARY_CLEANUP_SECONDS=60
SOURCE_LIBRARY_MAX_REQUEST_BYTES=22020096
SOURCE_LIBRARY_ALLOWED_ORIGINS=https://proofline.example,http://127.0.0.1:8000,http://localhost:4173

# Durable persistence remains disabled unless this is explicitly changed after Auth/RLS review.
SOURCE_LIBRARY_PERSISTENCE_BACKEND=process-local

# Future Supabase activation. The browser may receive only the publishable key. The secret key is
# backend-only and is required for reviewed TTL/deletion/provider-transfer orchestration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=proofline-source-library
