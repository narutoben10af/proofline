# Server-side only. Never expose this value in browser code or commit a real key.
GOOGLE_API_KEY=

# The provider boundary defaults to hosted Gemma 4. Keep the key server-side.
MODEL_PROVIDER=gemma
GEMMA_MODEL=gemma-4-26b-a4b-it

# Enforced prototype safety limits.
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1
