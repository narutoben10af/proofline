# Browser-visible configuration. Both values empty means Google sign-in is not configured.
# Use only the MagicFin project URL and its sb_publishable_ key. Never place a secret/service key,
# Google client secret, access token, refresh token, or user data in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=
