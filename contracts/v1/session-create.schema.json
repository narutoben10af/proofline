{
  "$defs": {
    "FixtureInput": {
      "additionalProperties": false,
      "properties": {
        "fixture_id": {
          "enum": [
            "apple-fy2025",
            "pcg-fy2025"
          ],
          "title": "Fixture Id",
          "type": "string"
        },
        "kind": {
          "const": "fixture",
          "default": "fixture",
          "title": "Kind",
          "type": "string"
        },
        "public_data_confirmed": {
          "const": true,
          "title": "Public Data Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "fixture_id",
        "public_data_confirmed"
      ],
      "title": "FixtureInput",
      "type": "object"
    },
    "UploadInput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "upload",
          "default": "upload",
          "title": "Kind",
          "type": "string"
        },
        "pdf_filename": {
          "maxLength": 255,
          "minLength": 5,
          "pattern": "(?i)^.+\\.pdf$",
          "title": "Pdf Filename",
          "type": "string"
        },
        "public_data_confirmed": {
          "const": true,
          "title": "Public Data Confirmed",
          "type": "boolean"
        },
        "workbook_filename": {
          "maxLength": 255,
          "minLength": 6,
          "pattern": "(?i)^.+\\.(xlsx|csv|json)$",
          "title": "Workbook Filename",
          "type": "string"
        }
      },
      "required": [
        "pdf_filename",
        "workbook_filename",
        "public_data_confirmed"
      ],
      "title": "UploadInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "input": {
      "discriminator": {
        "mapping": {
          "fixture": "#/$defs/FixtureInput",
          "upload": "#/$defs/UploadInput"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FixtureInput"
        },
        {
          "$ref": "#/$defs/UploadInput"
        }
      ],
      "title": "Input"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "input"
  ],
  "title": "CreateSessionRequest",
  "type": "object"
}
