{
  "components": {
    "schemas": {
      "AnalysisItem": {
        "additionalProperties": false,
        "properties": {
          "calculation_plan": {
            "$ref": "#/components/schemas/MetricCalculationPlan"
          },
          "claim_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Claim Id",
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "calculation_plan"
        ],
        "title": "AnalysisItem",
        "type": "object"
      },
      "AnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "claims": {
            "items": {
              "$ref": "#/components/schemas/FinancialClaim-Input"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Claims",
            "type": "array"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentVersion"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Documents",
            "type": "array"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AnalysisItem"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/FactObservation-Input"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Observations",
            "type": "array"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "source_spans": {
            "items": {
              "$ref": "#/components/schemas/SourceSpan"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Source Spans",
            "type": "array"
          }
        },
        "required": [
          "documents",
          "source_spans",
          "claims",
          "observations",
          "items"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisResponse": {
        "additionalProperties": false,
        "properties": {
          "cached_output": {
            "const": false,
            "default": false,
            "title": "Cached Output",
            "type": "boolean"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/FinancialClaim-Output"
            },
            "title": "Claims",
            "type": "array"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentVersion"
            },
            "title": "Documents",
            "type": "array"
          },
          "fallback_disclosure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Disclosure"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "metric_registry_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Metric Registry Version",
            "type": "string"
          },
          "metric_results": {
            "items": {
              "$ref": "#/components/schemas/MetricResult"
            },
            "title": "Metric Results",
            "type": "array"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/FactObservation-Output"
            },
            "title": "Observations",
            "type": "array"
          },
          "output_status": {
            "const": "calculated",
            "default": "calculated",
            "title": "Output Status",
            "type": "string"
          },
          "policy_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Policy Version",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "source_spans": {
            "items": {
              "$ref": "#/components/schemas/SourceSpan"
            },
            "title": "Source Spans",
            "type": "array"
          }
