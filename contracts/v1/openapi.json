{
  "components": {
    "schemas": {
      "AnalysisItem": {
        "additionalProperties": false,
        "properties": {
          "calculation_plan": {
            "$ref": "#/components/schemas/MetricCalculationPlan"
          },
          "claim_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Claim Id",
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "calculation_plan"
        ],
        "title": "AnalysisItem",
        "type": "object"
      },
      "AnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "claims": {
            "items": {
              "$ref": "#/components/schemas/FinancialClaim"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Claims",
            "type": "array"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AnalysisItem"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/FactObservation"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Observations",
            "type": "array"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "claims",
          "observations",
          "items"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisResponse": {
        "additionalProperties": false,
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "metric_registry_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Metric Registry Version",
            "type": "string"
          },
          "metric_results": {
            "items": {
              "$ref": "#/components/schemas/MetricResult"
            },
            "title": "Metric Results",
            "type": "array"
          },
          "policy_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Policy Version",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "metric_results",
          "findings"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "CalculationInput": {
        "additionalProperties": false,
        "properties": {
          "observation_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Observation Id",
            "type": "string"
          },
          "role": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "observation_id"
        ],
        "title": "CalculationInput",
        "type": "object"
      },
      "Classification": {
        "enum": [
          "supported",
          "uncertain",
          "contradicted"
        ],
        "title": "Classification",
        "type": "string"
      },
      "ExceptionalState": {
        "enum": [
          "missing_input",
          "incomparable",
          "zero_or_negative_denominator",
          "unresolved_sign",
          "invalid_plan"
        ],
        "title": "ExceptionalState",
        "type": "string"
      },
      "FactObservation": {
        "additionalProperties": false,
        "properties": {
          "concept": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Concept",
            "type": "string"
          },
          "currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "display_value": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Display Value",
            "type": "string"
          },
          "entity_scope": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Entity Scope",
            "type": "string"
          },
          "fixture_status": {
            "enum": [
              "official",
              "derived"
            ],
            "title": "Fixture Status",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Id",
            "type": "string"
          },
          "numeric_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Numeric Value"
          },
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "restated": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restated"
          },
          "sign_convention": {
            "anyOf": [
              {
                "enum": [
                  "positive",
                  "cash_outflow_positive",
                  "cash_outflow_negative"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sign Convention"
          },
          "source_span_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Source Span Id",
            "type": "string"
          },
          "unit": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_span_id",
          "concept",
          "numeric_value",
          "display_value",
          "unit",
          "period",
          "entity_scope",
          "restated",
          "fixture_status"
        ],
        "title": "FactObservation",
        "type": "object"
      },
      "FinancialClaim": {
        "additionalProperties": false,
        "properties": {
          "asserted_direction": {
            "anyOf": [
              {
                "enum": [
                  "up",
                  "down",
                  "flat"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asserted Direction"
          },
          "asserted_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asserted Value"
          },
          "currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "entity": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity"
          },
          "extraction_warnings": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Extraction Warnings",
            "type": "array"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Id",
            "type": "string"
          },
          "metric_id": {
            "$ref": "#/components/schemas/MetricId"
          },
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "source_span_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Source Span Id",
            "type": "string"
          },
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "unit": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "required": [
          "id",
          "text",
          "metric_id",
          "period",
          "source_span_id"
        ],
        "title": "FinancialClaim",
        "type": "object"
      },
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Claim Id",
            "type": "string"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification"
          },
          "evidence_source_span_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            "title": "Evidence Source Span Ids",
            "type": "array"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Id",
            "type": "string"
          },
          "metric_result_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Metric Result Id",
            "type": "string"
          },
          "policy_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Policy Version",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "suggested_investigation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Investigation"
          },
          "tolerance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tolerance"
          },
          "warnings": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "id",
          "claim_id",
          "metric_result_id",
          "classification",
          "rationale",
          "evidence_source_span_ids"
        ],
        "title": "Finding",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "metric_registry_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Metric Registry Version",
            "type": "string"
          },
          "model_configured": {
            "title": "Model Configured",
            "type": "boolean"
          },
          "model_provider": {
            "title": "Model Provider",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "model_provider",
          "model_configured"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MetricCalculationPlan": {
        "additionalProperties": false,
        "description": "A data-only dispatch plan; expressions and executable code are not accepted.",
        "properties": {
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/CalculationInput"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Inputs",
            "type": "array"
          },
          "metric_id": {
            "$ref": "#/components/schemas/MetricId"
          }
        },
        "required": [
          "metric_id",
          "inputs"
        ],
        "title": "MetricCalculationPlan",
        "type": "object"
      },
      "MetricId": {
        "enum": [
          "revenue_growth_yoy",
          "operating_margin",
          "current_ratio",
          "fcf_margin"
        ],
        "title": "MetricId",
        "type": "string"
      },
      "MetricResult": {
        "additionalProperties": false,
        "properties": {
          "exceptional_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExceptionalState"
              },
              {
                "type": "null"
              }
            ]
          },
          "formula_id": {
            "title": "Formula Id",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Id",
            "type": "string"
          },
          "input_observation_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            "title": "Input Observation Ids",
            "type": "array"
          },
          "metric_id": {
            "$ref": "#/components/schemas/MetricId"
          },
          "registry_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Registry Version",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "warnings": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "id",
          "metric_id",
          "formula_id",
          "input_observation_ids"
        ],
        "title": "MetricResult",
        "type": "object"
      },
      "Period": {
        "additionalProperties": false,
        "properties": {
          "duration_weeks": {
            "anyOf": [
              {
                "maximum": 54.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Weeks"
          },
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          }
        },
        "required": [
          "end"
        ],
        "title": "Period",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Contract-first deterministic financial claim analysis prototype.",
    "title": "Proofline API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/analyses": {
      "post": {
        "operationId": "create_analysis_api_v1_analyses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Analysis",
        "tags": [
          "analysis"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    }
  }
}
