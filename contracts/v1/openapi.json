      },
      "CreateSessionRequest": {
        "additionalProperties": false,
        "properties": {
          "input": {
            "discriminator": {
              "mapping": {
                "fixture": "#/components/schemas/FixtureInput",
                "upload": "#/components/schemas/UploadInput"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/FixtureInput"
              },
              {
                "$ref": "#/components/schemas/UploadInput"
              }
            ],
            "title": "Input"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "input"
