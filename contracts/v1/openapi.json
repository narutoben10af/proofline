      "CalculationInput": {
        "additionalProperties": false,
        "properties": {
          "observation_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Observation Id",
            "type": "string"
          },
