            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Session Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "accepted",
              "processing",
              "completed",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "state",
          "input",
          "cached_output_status"
        ],
        "title": "SessionStatus",
        "type": "object"
      },
      "SourceSpan": {
        "additionalProperties": false,
        "properties": {
          "document_version_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
