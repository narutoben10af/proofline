              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/PdfSourceRef"
              },
              {
                "$ref": "#/components/schemas/SpreadsheetSourceRef"
              }
            ],
            "title": "Source"
          }
        },
        "required": [
          "id",
          "document_version_id",
          "source"
        ],
        "title": "SourceSpan",
        "type": "object"
      },
      "SpreadsheetSourceRef": {
        "additionalProperties": false,
        "properties": {
          "cell": {
            "pattern": "^[A-Z]{1,3}[1-9][0-9]*(?::[A-Z]{1,3}[1-9][0-9]*)?$",
            "title": "Cell",
            "type": "string"
          },
          "display_value": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Display Value",
            "type": "string"
          },
          "document_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Document Id",
            "type": "string"
          },
          "kind": {
            "const": "spreadsheet",
            "default": "spreadsheet",
            "title": "Kind",
            "type": "string"
          },
          "sheet": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Sheet",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "sheet",
          "cell",
          "display_value"
        ],
        "title": "SpreadsheetSourceRef",
        "type": "object"
      },
      "UploadInput": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "upload",
            "default": "upload",
            "title": "Kind",
            "type": "string"
          },
          "pdf_filename": {
            "maxLength": 255,
            "minLength": 5,
            "pattern": "(?i)^.+\\.pdf$",
            "title": "Pdf Filename",
            "type": "string"
          },
          "public_data_confirmed": {
            "const": true,
            "title": "Public Data Confirmed",
            "type": "boolean"
          },
          "workbook_filename": {
            "maxLength": 255,
            "minLength": 6,
            "pattern": "(?i)^.+\\.(xlsx|csv|json)$",
            "title": "Workbook Filename",
            "type": "string"
          }
        },
        "required": [
          "pdf_filename",
          "workbook_filename",
          "public_data_confirmed"
        ],
        "title": "UploadInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
