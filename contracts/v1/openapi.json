            "title": "Registry Version",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "warnings": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "id",
          "metric_id",
          "formula_id",
          "input_observation_ids"
        ],
        "title": "MetricResult",
        "type": "object"
      },
      "PdfSourceRef": {
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Document Id",
            "type": "string"
          },
          "kind": {
            "const": "pdf",
            "default": "pdf",
            "title": "Kind",
            "type": "string"
          },
          "page": {
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          },
          "quote": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "page",
          "quote"
        ],
        "title": "PdfSourceRef",
        "type": "object"
      },
      "Period": {
        "additionalProperties": false,
        "properties": {
          "duration_weeks": {
            "anyOf": [
              {
                "maximum": 54.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Weeks"
          },
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          }
        },
        "required": [
          "end"
        ],
        "title": "Period",
        "type": "object"
      },
      "ProcessingError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "stage": {
            "enum": [
              "intake",
              "pdf",
              "workbook",
              "model",
              "analysis"
            ],
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "code",
          "stage",
          "message",
          "retryable"
        ],
        "title": "ProcessingError",
        "type": "object"
      },
      "SessionStatus": {
        "additionalProperties": false,
        "properties": {
          "cached_output_status": {
            "enum": [
              "not_checked",
              "available",
              "in_use",
              "unavailable"
            ],
            "title": "Cached Output Status",
            "type": "string"
          },
          "errors": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ProcessingError"
            },
            "title": "Errors",
            "type": "array"
