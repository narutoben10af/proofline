          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Id",
            "type": "string"
          },
          "input_observation_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            "title": "Input Observation Ids",
            "type": "array"
          },
          "metric_id": {
            "$ref": "#/components/schemas/MetricId"
