{
  "additionalProperties": false,
  "properties": {
    "byte_count": {
      "minimum": 0,
      "title": "Byte Count",
      "type": "integer"
    },
    "canonical_type": {
      "enum": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      ],
      "title": "Canonical Type",
      "type": "string"
    },
    "display_name": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "file_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "File Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "report_pdf",
        "workbook"
      ],
      "title": "Role",
      "type": "string"
    },
    "uploaded_at": {
      "format": "date-time",
      "title": "Uploaded At",
      "type": "string"
    },
    "validation_status": {
      "enum": [
        "Uploading",
        "Checking",
        "Ready",
        "Needs attention"
      ],
      "title": "Validation Status",
      "type": "string"
    }
  },
  "required": [
    "file_id",
    "display_name",
    "canonical_type",
    "byte_count",
    "uploaded_at",
    "validation_status",
    "role",
    "expires_at"
  ],
  "title": "SourceFileMetadata",
  "type": "object"
}
