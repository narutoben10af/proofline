{
  "$defs": {
    "EvidenceCitation": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source_span_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Source Span Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_span_id",
        "label"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "ProviderError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "not_configured",
            "offline",
            "provider_error",
            "unsupported_prompt"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ProviderError",
      "type": "object"
    },
    "ProviderState": {
      "enum": [
        "not_configured",
        "loading",
        "completed",
        "offline",
        "error",
        "fallback"
      ],
      "title": "ProviderState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "citations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceCitation"
      },
      "maxItems": 12,
      "title": "Citations",
      "type": "array"
    },
    "content": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content"
    },
    "disclosure": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Disclosure",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ProviderState"
    }
  },
  "required": [
    "state",
    "provider",
    "model",
    "disclosure"
  ],
  "title": "AssistantResult",
  "type": "object"
}
