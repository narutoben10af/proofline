{
  "$defs": {
    "AnalysisItem": {
      "additionalProperties": false,
      "properties": {
        "calculation_plan": {
          "$ref": "#/$defs/MetricCalculationPlan"
        },
        "claim_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Claim Id",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "calculation_plan"
      ],
      "title": "AnalysisItem",
      "type": "object"
    },
    "CalculationInput": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Observation Id",
          "type": "string"
        },
        "role": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "observation_id"
      ],
      "title": "CalculationInput",
      "type": "object"
    },
    "DocumentVersion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "issuer": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Issuer",
          "type": "string"
        },
        "reporting_basis": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reporting Basis",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "version_label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256",
        "issuer",
        "source_url",
        "retrieved_at",
        "reporting_basis",
        "version_label"
      ],
      "title": "DocumentVersion",
      "type": "object"
    },
    "FactObservation": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "display_value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Value",
          "type": "string"
        },
        "entity_scope": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Entity Scope",
          "type": "string"
        },
        "fixture_status": {
          "enum": [
            "official",
            "derived"
          ],
          "title": "Fixture Status",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Numeric Value"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "restated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Restated"
        },
        "sign_convention": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "cash_outflow_positive",
                "cash_outflow_negative"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sign Convention"
        },
        "source_span_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Source Span Id",
          "type": "string"
        },
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_span_id",
        "concept",
        "numeric_value",
        "display_value",
        "unit",
        "period",
        "entity_scope",
        "restated",
        "fixture_status"
      ],
      "title": "FactObservation",
      "type": "object"
    },
    "FinancialClaim": {
      "additionalProperties": false,
      "properties": {
        "asserted_direction": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "flat"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asserted Direction"
        },
        "asserted_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asserted Value"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "entity": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "extraction_warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Extraction Warnings",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "metric_id": {
          "$ref": "#/$defs/MetricId"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "source_span_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Source Span Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "id",
        "text",
        "metric_id",
        "period",
        "source_span_id"
      ],
      "title": "FinancialClaim",
      "type": "object"
    },
    "MetricCalculationPlan": {
      "additionalProperties": false,
      "description": "A data-only dispatch plan; expressions and executable code are not accepted.",
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/CalculationInput"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "metric_id": {
          "$ref": "#/$defs/MetricId"
        }
      },
      "required": [
        "metric_id",
        "inputs"
      ],
      "title": "MetricCalculationPlan",
      "type": "object"
    },
    "MetricId": {
      "enum": [
        "revenue_growth_yoy",
        "operating_margin",
        "current_ratio",
        "fcf_margin"
      ],
      "title": "MetricId",
      "type": "string"
    },
    "PdfSourceRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "kind": {
          "const": "pdf",
          "default": "pdf",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "page",
        "quote"
      ],
      "title": "PdfSourceRef",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "duration_weeks": {
          "anyOf": [
            {
              "maximum": 54,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Weeks"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "end"
      ],
      "title": "Period",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Document Version Id",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "discriminator": {
            "mapping": {
              "pdf": "#/$defs/PdfSourceRef",
              "spreadsheet": "#/$defs/SpreadsheetSourceRef"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PdfSourceRef"
            },
            {
              "$ref": "#/$defs/SpreadsheetSourceRef"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "id",
        "document_version_id",
        "source"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "SpreadsheetSourceRef": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]*(?::[A-Z]{1,3}[1-9][0-9]*)?$",
          "title": "Cell",
          "type": "string"
        },
        "display_value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Value",
          "type": "string"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "kind": {
          "const": "spreadsheet",
          "default": "spreadsheet",
          "title": "Kind",
          "type": "string"
        },
        "sheet": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sheet",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "sheet",
        "cell",
        "display_value"
      ],
      "title": "SpreadsheetSourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/FinancialClaim"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/DocumentVersion"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/AnalysisItem"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/FactObservation"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_spans": {
      "items": {
        "$ref": "#/$defs/SourceSpan"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Source Spans",
      "type": "array"
    }
  },
  "required": [
    "documents",
    "source_spans",
    "claims",
    "observations",
    "items"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
