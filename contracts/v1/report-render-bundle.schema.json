{
  "$defs": {
    "AnalysisResponse": {
      "additionalProperties": false,
      "properties": {
        "cached_output": {
          "const": false,
          "default": false,
          "title": "Cached Output",
          "type": "boolean"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/FinancialClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/DocumentVersion"
          },
          "title": "Documents",
          "type": "array"
        },
        "fallback_disclosure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Disclosure"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "metric_registry_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Metric Registry Version",
          "type": "string"
        },
        "metric_results": {
          "items": {
            "$ref": "#/$defs/MetricResult"
          },
          "title": "Metric Results",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/FactObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "output_status": {
          "const": "calculated",
          "default": "calculated",
          "title": "Output Status",
          "type": "string"
        },
        "policy_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Policy Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Source Spans",
          "type": "array"
        }
      },
      "required": [
        "documents",
        "source_spans",
        "claims",
        "observations",
        "metric_results",
        "findings"
      ],
      "title": "AnalysisResponse",
      "type": "object"
    },
    "Classification": {
      "enum": [
        "supported",
        "uncertain",
        "contradicted"
      ],
      "title": "Classification",
      "type": "string"
    },
    "ClassificationCounts": {
      "additionalProperties": false,
      "properties": {
        "contradicted": {
          "minimum": 0,
          "title": "Contradicted",
          "type": "integer"
        },
        "supported": {
          "minimum": 0,
          "title": "Supported",
          "type": "integer"
        },
        "uncertain": {
          "minimum": 0,
          "title": "Uncertain",
          "type": "integer"
        }
      },
      "required": [
        "supported",
        "uncertain",
        "contradicted"
      ],
      "title": "ClassificationCounts",
      "type": "object"
    },
    "DocumentVersion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "issuer": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Issuer",
          "type": "string"
        },
        "reporting_basis": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reporting Basis",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "version_label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256",
        "issuer",
        "source_url",
        "retrieved_at",
        "reporting_basis",
        "version_label"
      ],
      "title": "DocumentVersion",
      "type": "object"
    },
    "ExceptionalState": {
      "enum": [
        "missing_input",
        "incomparable",
        "zero_or_negative_denominator",
        "unresolved_sign",
        "invalid_plan",
        "numeric_range"
      ],
      "title": "ExceptionalState",
      "type": "string"
    },
    "FactObservation": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "display_value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Value",
          "type": "string"
        },
        "entity_scope": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Entity Scope",
          "type": "string"
        },
        "fixture_status": {
          "enum": [
            "official",
            "derived"
          ],
          "title": "Fixture Status",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "numeric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Numeric Value"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "restated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Restated"
        },
        "sign_convention": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "cash_outflow_positive",
                "cash_outflow_negative"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sign Convention"
        },
        "source_span_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Source Span Id",
          "type": "string"
        },
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_span_id",
        "concept",
        "numeric_value",
        "display_value",
        "unit",
        "period",
        "entity_scope",
        "restated",
        "fixture_status"
      ],
      "title": "FactObservation",
      "type": "object"
    },
    "FinancialClaim": {
      "additionalProperties": false,
      "properties": {
        "asserted_direction": {
          "anyOf": [
            {
              "enum": [
                "up",
                "down",
                "flat"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asserted Direction"
        },
        "asserted_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asserted Value"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "entity": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "extraction_warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Extraction Warnings",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "metric_id": {
          "$ref": "#/$defs/MetricId"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "source_span_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Source Span Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "id",
        "text",
        "metric_id",
        "period",
        "source_span_id"
      ],
      "title": "FinancialClaim",
      "type": "object"
    },
    "FinancialTrendPoint": {
      "additionalProperties": false,
      "properties": {
        "evidence_source_span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Source Span Id"
        },
        "historical": {
          "const": true,
          "default": true,
          "title": "Historical",
          "type": "boolean"
        },
        "official_source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Source Url"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "reporting_basis": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reporting Basis",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "period",
        "value",
        "reporting_basis"
      ],
      "title": "FinancialTrendPoint",
      "type": "object"
    },
    "FinancialTrendSeries": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "includes_forecast": {
          "const": false,
          "default": false,
          "title": "Includes Forecast",
          "type": "boolean"
        },
        "indicator": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Indicator",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/FinancialTrendPoint"
          },
          "maxItems": 20,
          "minItems": 3,
          "title": "Points",
          "type": "array"
        },
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "company",
        "indicator",
        "unit",
        "points"
      ],
      "title": "FinancialTrendSeries",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Claim Id",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "evidence_source_span_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "title": "Evidence Source Span Ids",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "metric_result_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Metric Result Id",
          "type": "string"
        },
        "policy_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Policy Version",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "suggested_investigation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Investigation"
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "claim_id",
        "metric_result_id",
        "classification",
        "rationale",
        "evidence_source_span_ids"
      ],
      "title": "Finding",
      "type": "object"
    },
    "InvestorReportProfile": {
      "additionalProperties": false,
      "description": "ID-only presentation choices; all displayed values resolve to hashed analysis evidence.",
      "properties": {
        "forecast": {
          "default": null,
          "title": "Forecast",
          "type": "null"
        },
        "primary_observation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Primary Observation Ids",
          "type": "array"
        },
        "reporting_period": {
          "$ref": "#/$defs/Period"
        },
        "reviewer_state": {
          "const": "reviewed",
          "default": "reviewed",
          "title": "Reviewer State",
          "type": "string"
        },
        "secondary_metric_result_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Secondary Metric Result Ids",
          "type": "array"
        }
      },
      "required": [
        "reporting_period",
        "primary_observation_ids",
        "secondary_metric_result_ids"
      ],
      "title": "InvestorReportProfile",
      "type": "object"
    },
    "MetricId": {
      "enum": [
        "revenue_growth_yoy",
        "operating_margin",
        "current_ratio",
        "fcf_margin"
      ],
      "title": "MetricId",
      "type": "string"
    },
    "MetricResult": {
      "additionalProperties": false,
      "properties": {
        "exceptional_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExceptionalState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "formula_id": {
          "title": "Formula Id",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "input_observation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "title": "Input Observation Ids",
          "type": "array"
        },
        "metric_id": {
          "$ref": "#/$defs/MetricId"
        },
        "registry_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Registry Version",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "metric_id",
        "formula_id",
        "input_observation_ids"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "PdfSourceRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "kind": {
          "const": "pdf",
          "default": "pdf",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "page",
        "quote"
      ],
      "title": "PdfSourceRef",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "duration_weeks": {
          "anyOf": [
            {
              "maximum": 54,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Weeks"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "end"
      ],
      "title": "Period",
      "type": "object"
    },
    "ReportSnapshot": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Analysis Id",
          "type": "string"
        },
        "classification_counts": {
          "$ref": "#/$defs/ClassificationCounts"
        },
        "economic_context_point_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Economic Context Point Ids",
          "type": "array"
        },
        "evidence_chain_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Chain Sha256",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Finding Ids",
          "type": "array"
        },
        "includes_forecast": {
          "const": false,
          "default": false,
          "title": "Includes Forecast",
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "review_status": {
          "const": "reviewed",
          "default": "reviewed",
          "title": "Review Status",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "analysis_id",
        "title",
        "reviewed_at",
        "classification_counts",
        "finding_ids",
        "evidence_chain_sha256",
        "economic_context_point_ids",
        "limitations"
      ],
      "title": "ReportSnapshot",
      "type": "object"
    },
    "ResolvedEconomicContextPoint": {
      "additionalProperties": false,
      "properties": {
        "caveat": {
          "const": "Context only; no causal relationship is asserted.",
          "default": "Context only; no causal relationship is asserted.",
          "title": "Caveat",
          "type": "string"
        },
        "company": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "comparability_warning": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Comparability Warning",
          "type": "string"
        },
        "default_visible": {
          "default": true,
          "title": "Default Visible",
          "type": "boolean"
        },
        "display_value": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Display Value",
          "type": "string"
        },
        "geography": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Geography",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
